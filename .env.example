# Copia este archivo como .env y completa la URL. NO subas .env al repositorio.
#
# Es la "URL de la aplicación web" que devuelve Apps Script al desplegar el
# proyecto de gas/ como Web App. Cambia cada vez que se publica una versión
# nueva: hay que actualizarla aquí y en el secret VITE_GAS_URL del repositorio.
#
# Ver GAS.md para el procedimiento completo.

VITE_GAS_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXXXXXX/exec
